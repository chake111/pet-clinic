{
  "schemaVersion": 1,
  "id": "demo-video-v1",
  "titleTemplate": "{{brand.name}} · 三端协同全流程演示",
  "brandSource": "frontend/src/brand.js",
  "videoSpec": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "aspectRatio": "16:9",
    "silent": true,
    "firstFrameIsProductUI": true,
    "language": "zh-CN",
    "maxDurationSec": 60,
    "targetDurationSec": 58,
    "maxSubtitleChars": 14,
    "minReadableFontPx": 32,
    "minOutroHoldSec": 2.5
  },
  "safeZones": {
    "titleSafe": {
      "ratio": 0.8,
      "xMin": 192,
      "xMax": 1728,
      "yMin": 108,
      "yMax": 972,
      "note": "字幕与功能标签须放在录屏外留白且完全落在此区域内，避开 B 站底栏进度条与顶部弹幕区，640×360 下可读"
    },
    "actionSafe": {
      "ratio": 0.9,
      "xMin": 96,
      "xMax": 1824,
      "yMin": 54,
      "yMax": 1026,
      "note": "左侧常驻进度轨须落在此区域内，不贴边"
    }
  },
  "visualTheme": {
    "sourceRef": "deploy/demo/agent-draft.html",
    "ink": "#222222",
    "body": "#3f3f3f",
    "paper": "#ffffff",
    "desk": "#f7f7f7",
    "rule": "#ebebeb",
    "action": "#d92549",
    "actionHover": "#c71e40",
    "actionActive": "#b51b39",
    "fontStack": [
      "Noto Sans SC",
      "Inter",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      "sans-serif"
    ],
    "localFontFallback": "C:\\Windows\\Fonts\\NotoSansSC-VF.ttf",
    "fontEnvVar": "YUZHUA_FONT_PATH",
    "assets": {
      "logo": "deploy/demo/agent-assets/logo.svg",
      "mascot": "deploy/demo/agent-assets/tuantuan.webp"
    }
  },
  "progressRail": [
    { "id": "owner", "label": "宠主" },
    { "id": "doctor", "label": "医生" },
    { "id": "admin", "label": "管理" }
  ],
  "environment": {
    "baseUrl": "http://127.0.0.1:8088",
    "timezone": "Asia/Shanghai",
    "locale": "zh-CN",
    "latestTodayBookingTime": "21:30",
    "outputDirTemplate": "output/demo-video/<YYYY-MM-DD>",
    "prepareSql": "tools/demo-video/prepare.sql",
    "mockPaymentPolicy": "show_as_is_no_mask"
  },
  "actors": {
    "owner": {
      "authSide": "client",
      "username": "zhangsan",
      "displayName": "张三",
