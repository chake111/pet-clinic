    "gapsAuthoritative": true,
    "syncOffsetField": "leftMinusRightSec",
    "syncFormula": "rightSec = leftSec - leftMinusRightSec",
    "targetCoordSemantics": "x,y,width,height = CSS px bounding box; cx,cy = CSS px click center; nx = cx / viewport.width, ny = cy / viewport.height"
  },
