@startuml yuzhua-core-classes
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam classFontStyle bold
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam nodesep 45
skinparam ranksep 45
hide circle
hide empty methods

top to bottom direction
class Pet {
  - id : Long
  - userId : Long
  - name : String
  - birthday : LocalDate
  - ageMonth : Integer
}
class DoctorSchedule {
  - id : Long
  - doctorId : Long
  - workDate : LocalDate
  - totalNum : Integer
  - remainNum : Integer
}
class Appointment {
  - id : Long
  - petId : Long
  - scheduleId : Long
  - status : Integer
  - payStatus : Integer
}
class MedicalRecord {
  - id : Long
  - appointmentId : Long
  - petId : Long
  - diagnosis : String
}
class ConsultSession {
  - id : Long
  - petId : Long
  - doctorId : Long
  - status : Integer
  - summary : String
}
Pet "1" -- "0..*" Appointment : 就诊
DoctorSchedule "1" -- "0..*" Appointment : 排班
Appointment "1" -- "0..1" MedicalRecord : 有效病历
Pet "1" -- "0..*" ConsultSession : 咨询
Pet "1" -- "0..*" MedicalRecord : 归属
DoctorSchedule -[hidden]right- Pet
Appointment -[hidden]right- ConsultSession
caption (a) 核心实体的业务关联
@enduml

@startuml yuzhua-core-services
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam classFontStyle bold
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam nodesep 40
skinparam ranksep 45
hide circle
top to bottom direction

class MedicalRecordService {
  - appointmentService : AppointmentService
  --
  + saveOrUpdateForAppointment(\n  appointmentId : Long, req : MedicalRecord)\n  : MedicalRecord
  + require(id : Long) : MedicalRecord
  + detail(id : Long) : MedicalRecordVo
}
class AppointmentService {
  - petService : PetService
  --
  + create(req : AppointmentForm) : AppointmentVo
  + pay(id : Long) : AppointmentVo
  + cancelByUser(id : Long, reason : String) : void
  + accept(id : Long) : void
  + finish(id : Long) : void
}
class PetService {
  - sysUserMapper : SysUserMapper
  --
  + create(req : Pet) : Pet
  + update(id : Long, req : Pet) : void
  + requireOwned(id : Long) : Pet
  - validate(req : Pet) : void
  - deriveAgeMonth(birthday : LocalDate) : Integer
}
class ConsultService {
  - petService : PetService
  --
  + create(req : ConsultForm) : ConsultSessionVo
  + accept(sessionId : Long) : void
  + close(sessionId : Long, summary : String) : void
  + requireMember(sessionId : Long) : ConsultSession
}
class DoctorScheduleService {
  - doctorMapper : DoctorMapper
  --
  + create(req : ScheduleForm) : DoctorSchedule
  + update(id : Long, req : ScheduleForm) : void
  + remove(id : Long) : void
  + stopClinic(id : Long) : void
  + resumeClinic(id : Long) : void
}
MedicalRecordService ..> AppointmentService : <<use>>
AppointmentService ..> PetService : <<use>>
ConsultService ..> PetService : <<use>>
MedicalRecordService -[hidden]right- DoctorScheduleService
DoctorScheduleService -[hidden]down- ConsultService
AppointmentService -[hidden]right- ConsultService
caption (b) 核心服务的属性、操作与使用依赖
@enduml
