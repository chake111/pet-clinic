* text=auto

# CI 与脚本统一 LF，避免 Windows 工作区把 CRLF 带进工作流
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.sh text eol=lf

# Docker、nginx 与 Compose 文件统一 LF，避免 Windows 检出后 CRLF 破坏构建
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.conf text eol=lf
*.dockerignore text eol=lf
compose.yaml text eol=lf
.env.example text eol=lf